{
  "name": "rumina",
  "description": "Lamina language compatible interpreter written in rust",
  "version": "1.2.7",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "yarn@4.11.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.3.5",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.0-rc.7",
    "rolldown-plugin-dts": "^0.22.4",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "lamina",
    "wasm",
    "webassembly",
    "math",
    "calculator",
    "rational",
    "bigint",
    "symbolic",
    "exact-math",
    "numerical-computing",
    "rumina"
  ],
  "scripts": {
    "build": "wasm-pack build --out-dir dist && yarn postbuild && node scripts/sync-wasm-bindings.js && rolldown -c rolldown.config.js",
    "postbuild": "rimraf dist/.gitignore dist/README.md dist/package.json dist/LICENSE",
    "lint": "biome check && biome lint",
    "lint-fix": "biome format --write && biome lint --write"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoshino-Yumetsuki/Rumina.git"
  },
  "bugs": {
    "url": "https://github.com/Hoshino-Yumetsuki/Rumina/issues"
  },
  "homepage": "https://github.com/Hoshino-Yumetsuki/Rumina#readme"
}
