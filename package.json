{
  "name": "rumina",
  "description": "Lamina language compatible interpreter written in rust",
  "version": "1.3.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.6.2",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.0",
    "rolldown-plugin-dts": "^0.25.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "lamina",
    "wasm",
    "webassembly",
    "math",
    "calculator",
    "rational",
    "bigint",
    "symbolic",
    "exact-math",
    "numerical-computing",
    "rumina"
  ],
  "scripts": {
    "build": "wasm-pack build --out-dir dist && yarn postbuild && node scripts/sync-wasm-bindings.js && rolldown -c rolldown.config.js",
    "check": "yarn check:version && yarn lint && yarn test:rust",
    "check:version": "node scripts/check-version.js",
    "coverage:rust": "node scripts/run-rust-command.js llvm-cov --workspace --lib --summary-only",
    "coverage:rust:lcov": "node scripts/run-rust-command.js llvm-cov --workspace --lib --lcov --output-path target/llvm-cov/lcov.info",
    "postbuild": "rimraf dist/.gitignore dist/README.md dist/package.json dist/LICENSE",
    "lint": "biome check && biome lint && cargo clippy --workspace --all-targets -- -D warnings",
    "lint-fix": "biome format --write && biome lint --write",
    "test:rust": "node scripts/run-rust-command.js test --workspace --lib",
    "test:rust:all": "node scripts/run-rust-command.js test --workspace",
    "test:versions": "node --test scripts/check-version.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoshino-Yumetsuki/Rumina.git"
  },
  "bugs": {
    "url": "https://github.com/Hoshino-Yumetsuki/Rumina/issues"
  },
  "homepage": "https://github.com/Hoshino-Yumetsuki/Rumina#readme"
}
